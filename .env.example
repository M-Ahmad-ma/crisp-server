# ── Server ────────────────────────────────────────────────────────────────
PORT=4000

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Local default. For Docker (see README):
#   docker run -d --name crispo-pg --network host \
#     -e POSTGRES_USER=crispo -e POSTGRES_PASSWORD=crispo \
#     -e POSTGRES_DB=crispo postgres:16-alpine
DATABASE_URL=postgres://crispo:crispo@127.0.0.1:5432/crispo

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=7d

# Seeded on first `npm run db:migrate` (only if no user exists yet)
ADMIN_EMAIL=admin@lays.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Factory Admin

# ── Paths ─────────────────────────────────────────────────────────────────
# Built React site served at "/" (relative to the server folder)
DIST_DIR=../react-project/dist

# ── API request/response logs ─────────────────────────────────────────────
# Every /api call is appended to logs/access.log (nothing is printed to the
# console), with the data the API returned (passwords/tokens masked).
LOG_REQUESTS=true
LOG_BODY_CHARS=2000     # max characters of body written per line (0 = no bodies)
LOG_FILE=true           # write logs/access.log
